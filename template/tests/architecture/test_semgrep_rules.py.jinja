"""Regression tests for the project's Semgrep architecture rules."""

import json
import subprocess
from collections.abc import Callable
from pathlib import Path
from typing import cast

import pytest

# Every test here waits on Semgrep's start-up, which a busy machine stretches past the timeout for
# plain unit tests; the shared scan's set-up also counts against the first test that asks for it,
# so one slow start would fail the whole module. This budget still stops a hung Semgrep.
SEMGREP_RUN_SECONDS = 30
pytestmark = pytest.mark.timeout(SEMGREP_RUN_SECONDS)

Findings = list[dict[str, object]]

REPOSITORY_ROOT = Path(__file__).parents[2]
FIXTURE_ROOT = REPOSITORY_ROOT / "tests/fixtures/semgrep"
PACKAGE_FIXTURES = FIXTURE_ROOT / "{{ package_name }}"
DOMAIN_FIXTURES = FIXTURE_ROOT / "domain"
RULE_PREFIX = "config.semgrep.guardrails."
# Semgrep's documented exit code for unparsable target code under --strict.
SYNTAX_ERROR_EXIT_CODE = 3
# Flags the tests share with the architecture check, so both scan files the same way.
SHARED_SCAN_FLAGS = ("--strict", "--no-git-ignore", "--metrics=off", "--disable-version-check")


def _run_semgrep(
    paths: list[Path], cwd: Path = REPOSITORY_ROOT
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [
            "semgrep",
            "scan",
            "--quiet",
            "--json",
            *SHARED_SCAN_FLAGS,
            "--config",
            str(REPOSITORY_ROOT / "config/semgrep/layer-boundaries.yml"),
            *map(str, paths),
        ],
        check=False,
        capture_output=True,
        cwd=cwd,
        text=True,
    )


def _scan(paths: list[Path]) -> Findings:
    completed = _run_semgrep(paths)
    assert completed.returncode == 0, completed.stdout + completed.stderr
    report = cast("dict[str, object]", json.loads(completed.stdout))
    return cast("Findings", report["results"])


ScanFixtures = Callable[[list[Path]], Findings]
# Every target the rule tests inspect; scanned together because Semgrep's start-up dominates.
SCANNED_TARGETS = tuple(sorted(FIXTURE_ROOT.rglob("*.py")))


@pytest.fixture(scope="module")
def scan() -> ScanFixtures:
    """Scan every target once; each call returns the findings for the requested files."""
    findings_by_path: dict[Path, Findings] = {path: [] for path in SCANNED_TARGETS}
    for finding in _scan(list(SCANNED_TARGETS)):
        findings_by_path[Path(cast("str", finding["path"]))].append(finding)

    def findings_for(paths: list[Path]) -> Findings:
        return [finding for path in paths for finding in findings_by_path[path]]

    return findings_for


def _rule(finding: dict[str, object]) -> str:
    return cast("str", finding["check_id"]).removeprefix(RULE_PREFIX)


def _lines_of(findings: Findings, rule: str) -> set[int]:
    return {
        cast("dict[str, int]", finding["start"])["line"]
        for finding in findings
        if _rule(finding) == rule
    }


def test_rules_apply_inside_pep695_generic_definitions(scan: ScanFixtures) -> None:
    findings = scan([FIXTURE_ROOT / "application/invalid_generic_direct_io.py"])

    assert _lines_of(findings, "core-direct-io") == {10, 16}


def test_partially_parsed_file_fails_the_scan(tmp_path: Path) -> None:
    unparsable = tmp_path / "application/unparsable.py"
    unparsable.parent.mkdir()
    unparsable.write_text('open("catalogue.txt")\nvalue = = 1\n', encoding="utf-8")

    # Rule path filters only match targets inside the scan's working directory.
    completed = _run_semgrep([unparsable.relative_to(tmp_path)], cwd=tmp_path)

    assert completed.returncode == SYNTAX_ERROR_EXIT_CODE
    errors = cast("list[dict[str, object]]", json.loads(completed.stdout)["errors"])
    assert [cast("list[str]", error["type"])[0] for error in errors] == ["PartialParsing"]


def test_architecture_check_scans_like_the_tests() -> None:
    compose = (REPOSITORY_ROOT / "compose.yaml").read_text(encoding="utf-8")
    scan_commands = [line for line in compose.splitlines() if "semgrep scan" in line]

    assert len(scan_commands) == 1, scan_commands
    assert set(SHARED_SCAN_FLAGS) <= set(scan_commands[0].split())


@pytest.mark.parametrize(
    ("fixture", "rule", "violating_lines"),
    (
        ("application/invalid_direct_io.py", "core-direct-io", {10, 11, 12, 13, 14, 15}),
        ("application/invalid_direct_io.py", "inner-layer-imports", {3, 4}),
        ("domain/invalid_direct_io.py", "core-direct-io", {5}),
        ("application/invalid_external_contract.py", "inner-layer-imports", {7}),
        (
            "application/invalid_external_contract.py",
            "core-no-raw-payload-contract",
            {16, 21, 26, 31, 36, 41},
        ),
        ("application/valid_private_mapping.py", "core-no-raw-payload-contract", set()),
        ("application/valid_use_case.py", "core-direct-io", set()),
        ("adapters/valid_dto.py", "inner-layer-imports", set()),
        ("application/invalid_filesystem_probe.py", "core-direct-io", {7, 8, 9, 10, 11, 12}),
        ("application/valid_path_values.py", "core-direct-io", set()),
    ),
)
def test_inner_layers_reach_the_outside_world_only_through_ports(
    scan: ScanFixtures, fixture: str, rule: str, violating_lines: set[int]
) -> None:
    assert _lines_of(scan([FIXTURE_ROOT / fixture]), rule) == violating_lines


