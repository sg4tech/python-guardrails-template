def handle_branching(args: Any, service: Any, view: Any) -> int:
    if args:
        return 1
    for item in service:
        del item
    while view:
        break
    try:
        return 0
    except ValueError:
        return 2
    match args:
        case _:
            pass
    return 1 if args else 0


def handle_hidden_loops(args: Any, service: Any, view: Any) -> int:
    del args, service
    view.show([item.name for item in view])
    view.show({item.name for item in view})
    view.show({item: item for item in view})
    view.show(sum(item.size for item in view))
    return 0


