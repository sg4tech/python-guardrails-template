"""The scanner reads NUL-separated paths, reports findings and fails when there are any."""

import io
from pathlib import Path

import pytest

from {{ package_name }}.devtools.secret_scan import main

from tests.devtools.rule_samples import SAMPLE_RULES

REPOSITORY_ROOT = Path(__file__).parents[2]
PROJECT_RULES = REPOSITORY_ROOT / "config" / "security-rules.toml"


def _scan(
    root: Path, paths: list[str], config: Path, capsys: pytest.CaptureFixture[str]
) -> tuple[int, str]:
    stdin = io.StringIO("\0".join(paths))
    code = main(["--config", str(config), "--root", str(root)], stdin)
    return code, capsys.readouterr().out


@pytest.fixture(name="sample_config")
def sample_config_fixture(tmp_path: Path) -> Path:
    config = tmp_path / "rules.toml"
    config.write_text(SAMPLE_RULES, encoding="utf-8")
    return config


def test_clean_files_pass(
    tmp_path: Path, sample_config: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    (tmp_path / "app.py").write_text("print('hello')\n", encoding="utf-8")

    code, output = _scan(tmp_path, ["app.py"], sample_config, capsys)

    assert code == 0
    assert output == "secret-scan files=1 findings=0\n"


def test_a_secret_fails_the_scan_and_is_located_but_not_echoed(
    tmp_path: Path, sample_config: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    key = "sk-" + "x" * 24
    (tmp_path / "app.py").write_text(f"key = {key!r}\n", encoding="utf-8")

    code, output = _scan(tmp_path, ["app.py"], sample_config, capsys)

    assert code == 1
    assert "app.py:1: rule=api-key (API key)" in output
    assert key not in output


def test_a_path_rule_applies_even_to_a_deleted_file(
    tmp_path: Path, sample_config: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    code, output = _scan(tmp_path, ["gone.log"], sample_config, capsys)

    assert code == 1
    assert "gone.log: rule=log-file (Log file)" in output


def test_binary_files_are_not_read_as_text(
    tmp_path: Path, sample_config: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    (tmp_path / "image.bin").write_bytes(b"\0sk-" + b"x" * 24)

    code, _ = _scan(tmp_path, ["image.bin"], sample_config, capsys)

    assert code == 0


@pytest.mark.parametrize(
    ("path", "text"),
    [
        ("a.py", "sk-" + "a" * 24),
        ("a.py", "gh" + "p_" + "a" * 36),
        ("a.py", "-----BEGIN " + "PRIVATE KEY-----"),
        ("a.py", "/Us" + "ers/someone/project"),
        ("a.py", "AK" + "IA" + "A" * 16),
        ("a.py", "https://user:" + "secret@example.com"),
        ("data/catalogue.sqlite3", ""),
        ("notes.db", ""),
        ("run.log", ""),
        (".env", ""),
        (".runtime/token.json", ""),
    ],
)
def test_the_project_rules_catch_each_kind_of_leak(
    tmp_path: Path, path: str, text: str, capsys: pytest.CaptureFixture[str]
) -> None:
    file = tmp_path / path
    file.parent.mkdir(parents=True, exist_ok=True)
    file.write_text(text, encoding="utf-8")

    code, _ = _scan(tmp_path, [path], PROJECT_RULES, capsys)

    assert code == 1


def test_the_example_environment_file_is_allowed(
    tmp_path: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    (tmp_path / ".env.example").write_text("API_URL=\n", encoding="utf-8")

    code, _ = _scan(tmp_path, [".env.example"], PROJECT_RULES, capsys)

    assert code == 0
