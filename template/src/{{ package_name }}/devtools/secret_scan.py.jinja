"""Scan the files named on standard input for secrets and private paths."""

import argparse
import sys
from collections.abc import Sequence
from pathlib import Path
from typing import TextIO

from {{ package_name }}.devtools.security_rules import Finding, RuleSet, parse_rules, scan_path, scan_text


def scan_files(rules: RuleSet, root: Path, paths: Sequence[str]) -> list[Finding]:
    findings: list[Finding] = []
    for path in paths:
        findings.extend(scan_path(rules, path))
        file = root / path
        if not file.is_file():
            continue
        data = file.read_bytes()
        if b"\0" in data:
            continue
        findings.extend(scan_text(rules, path, data.decode("utf-8", errors="replace")))
    return findings


def read_paths(stream: TextIO) -> list[str]:
    """Read NUL-separated repository-relative paths."""
    return [path for path in stream.read().split("\0") if path]


def main(argv: Sequence[str] | None = None, stdin: TextIO | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=Path("config/security-rules.toml"))
    parser.add_argument("--root", type=Path, default=Path())
    arguments = parser.parse_args(argv)

    rules = parse_rules(arguments.config.read_text())
    paths = read_paths(stdin if stdin is not None else sys.stdin)
    findings = scan_files(rules, arguments.root, paths)
    for finding in findings:
        location = finding.path if finding.line is None else f"{finding.path}:{finding.line}"
        print(f"{location}: rule={finding.rule_id} ({finding.description})")
    print(f"secret-scan files={len(paths)} findings={len(findings)}")
    return 1 if findings else 0


if __name__ == "__main__":
    raise SystemExit(main())
