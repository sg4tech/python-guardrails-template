"""Keep notes in a JSON file."""

import json
from datetime import datetime
from pathlib import Path
from typing import TypedDict

from {{ package_name }}.domain.value_objects.note import Note


class NoteRecord(TypedDict):
    text: str
    written_at: str


class JsonNoteStore:
    def __init__(self, path: Path) -> None:
        self._path = path

    def append(self, note: Note) -> None:
        records = [
            *self._read(),
            NoteRecord(text=note.text, written_at=note.written_at.isoformat()),
        ]
        self._path.parent.mkdir(parents=True, exist_ok=True)
        self._path.write_text(json.dumps(records, indent=2), encoding="utf-8")

    def list_notes(self) -> tuple[Note, ...]:
        return tuple(
            Note(record["text"], datetime.fromisoformat(record["written_at"]))
            for record in self._read()
        )

    def _read(self) -> list[NoteRecord]:
        if not self._path.exists():
            return []
        records: list[NoteRecord] = json.loads(self._path.read_text(encoding="utf-8"))
        return records
