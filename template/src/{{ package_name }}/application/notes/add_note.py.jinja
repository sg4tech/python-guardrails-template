"""Write a note down at the current time."""

from dataclasses import dataclass

from {{ package_name }}.application.notes.ports import Clock, NoteStore
from {{ package_name }}.domain.value_objects.note import Note


@dataclass(frozen=True)
class AddNote:
    store: NoteStore
    clock: Clock

    def execute(self, text: str) -> Note:
        note = Note(text, self.clock.now())
        self.store.append(note)
        return note
